#!/usr/bin/env python3
"""
mc-rclone-bridge - On-demand Rclone FTP bridge for GNU Midnight Commander.
Binds to MC parent PID and terminates automatically on MC exit.
"""

import sys
import os
import time
import socket
import subprocess
import configparser
import shutil
import signal

PORT = int(os.getenv("MC_RCLONE_PORT", "2123"))
ADDR = os.getenv("MC_RCLONE_ADDR", "127.0.0.1")

def get_real_home():
    home = os.environ.get("HOME", "")
    if "multiagy" in home or not os.path.isdir(os.path.join(home, ".config")):
        if os.path.isdir("/Users/michele"):
            return "/Users/michele"
    return os.path.expanduser("~")

REAL_HOME = get_real_home()
CACHE_DIR = os.path.join(REAL_HOME, ".cache", "mc", "rclone")
PID_FILE = os.path.join(CACHE_DIR, "bridge.pid")
LOG_FILE = os.path.join(CACHE_DIR, "bridge.log")

def find_rclone_conf():
    for p in [
        os.path.join(REAL_HOME, ".config", "rclone", "rclone.conf"),
        os.path.expanduser("~/.config/rclone/rclone.conf"),
    ]:
        if os.path.isfile(p):
            return p
    return os.path.join(REAL_HOME, ".config", "rclone", "rclone.conf")

def is_port_open(host, port):
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(0.3)
    try:
        res = sock.connect_ex((host, port))
        return res == 0
    finally:
        sock.close()

def is_pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False

def find_mc_pid():
    curr = os.getpid()
    while curr > 1:
        try:
            out = subprocess.check_output(
                ["ps", "-o", "ppid=", "-o", "comm=", "-p", str(curr)],
                text=True
            ).strip()
            parts = out.split(None, 1)
            if not parts:
                break
            ppid = int(parts[0])
            comm = parts[1] if len(parts) > 1 else ""
            base = os.path.basename(comm).lower()
            if base in ("mc", "midnight-commander") or "mc" == base:
                return curr
            curr = ppid
        except Exception:
            break
    return None

def get_remotes():
    """Extract configured remotes. For SFTP remotes, probes port (0.2s) to avoid combine startup crashes."""
    conf_path = find_rclone_conf()
    if not os.path.isfile(conf_path):
        return []
    parser = configparser.ConfigParser()
    try:
        parser.read(conf_path)
    except Exception:
        return []

    active_remotes = []
    for sec in parser.sections():
        if sec.startswith("_"):
            continue
        rtype = parser[sec].get("type", "")
        if rtype == "sftp":
            host = parser[sec].get("host", "")
            port = int(parser[sec].get("port", 22))
            try:
                s = socket.socket()
                s.settimeout(0.2)
                if s.connect_ex((host, port)) == 0:
                    active_remotes.append(sec)
                s.close()
            except Exception:
                pass
        else:
            active_remotes.append(sec)

    return active_remotes

def stop():
    if os.path.isfile(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            if is_pid_alive(pid):
                os.kill(pid, signal.SIGTERM)
                for _ in range(25):
                    time.sleep(0.1)
                    if not is_pid_alive(pid):
                        break
                if is_pid_alive(pid):
                    os.kill(pid, signal.SIGKILL)
        except Exception:
            pass
        try:
            os.remove(PID_FILE)
        except Exception:
            pass
    print("mc-rclone-bridge stopped.")
    return 0

def status():
    if os.path.isfile(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            if is_pid_alive(pid) and is_port_open(ADDR, PORT):
                print(f"mc-rclone-bridge is running (PID {pid}, listening on {ADDR}:{PORT}).")
                return 0
        except Exception:
            pass
    print("mc-rclone-bridge is stopped.")
    return 1

def start(parent_pid=None):
    os.makedirs(CACHE_DIR, exist_ok=True)
    if is_port_open(ADDR, PORT):
        # Server is already running
        return 0

    if parent_pid is None or parent_pid <= 1:
        parent_pid = find_mc_pid() or os.getppid()

    remotes = get_remotes()
    if not remotes:
        sys.stderr.write("Error: No active remotes found in rclone.conf\n")
        return 1

    upstreams = " ".join([f"{r}={r}:" for r in remotes])
    rclone_bin = shutil.which("rclone") or "/opt/homebrew/bin/rclone"
    conf_path = find_rclone_conf()

    cmd = [
        rclone_bin,
        "--config", conf_path,
        "serve", "ftp",
        "--combine-upstreams", upstreams,
        "--vfs-cache-mode", "writes",
        "--addr", f"{ADDR}:{PORT}",
        ":combine:"
    ]

    daemon_code = f"""
import subprocess, time, os, sys, signal

parent_pid = {parent_pid}
cmd = {cmd!r}
pid_file = {PID_FILE!r}
log_file = {LOG_FILE!r}

with open(log_file, "a") as log:
    proc = subprocess.Popen(cmd, stdout=log, stderr=log)
    with open(pid_file, "w") as f:
        f.write(str(proc.pid))

    try:
        while True:
            time.sleep(1.0)
            if proc.poll() is not None:
                break
            if parent_pid and parent_pid > 1:
                try:
                    os.kill(parent_pid, 0)
                except (OSError, ProcessLookupError):
                    break
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
        if os.path.isfile(pid_file):
            try:
                os.remove(pid_file)
            except Exception:
                pass
"""
    subprocess.Popen(
        [sys.executable, "-c", daemon_code],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    for _ in range(40):
        time.sleep(0.1)
        if is_port_open(ADDR, PORT):
            return 0

    sys.stderr.write("Error: Timed out waiting for FTP server to listen.\n")
    return 1

def main():
    if len(sys.argv) < 2:
        print("Usage: mc-rclone-bridge {start [mc_pid]|stop|status}")
        sys.exit(1)

    cmd = sys.argv[1].lower()
    if cmd == "start":
        parent_pid = int(sys.argv[2]) if len(sys.argv) > 2 else None
        sys.exit(start(parent_pid))
    elif cmd == "stop":
        sys.exit(stop())
    elif cmd == "status":
        sys.exit(status())
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
