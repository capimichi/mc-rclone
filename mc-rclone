#!/usr/bin/env python3
"""
mc-rclone - On-demand Rclone FTP bridge for GNU Midnight Commander.
Supports XDG configuration, configurable VFS cache, and multi-instance MC watchdog.
"""

import sys
import os
import time
import socket
import subprocess
import configparser
import shutil
import signal
from pathlib import Path


def get_real_home():
    if os.environ.get("MC_RCLONE_HOME"):
        return os.environ["MC_RCLONE_HOME"]
    home = os.environ.get("HOME", "")
    if "multiagy" in home or not os.path.isdir(os.path.join(home, ".config")):
        if os.path.isdir("/Users/michele"):
            return "/Users/michele"
    return os.path.expanduser("~")


REAL_HOME = get_real_home()
CACHE_DIR = Path(REAL_HOME) / ".cache" / "mc" / "rclone"
PID_FILE = CACHE_DIR / "bridge.pid"
LOG_FILE = CACHE_DIR / "bridge.log"

CONFIG_DIR = Path(REAL_HOME) / ".config" / "mc-rclone"
CONFIG_FILE = CONFIG_DIR / "config.ini"

DEFAULT_CONFIG_CONTENT = """# mc-rclone configuration file

[server]
# Local IP address to bind the FTP server (loopback for security)
bind_address = 127.0.0.1

# Local FTP port used by rclone and configured in Midnight Commander hotlist
port = 2123

[vfs]
# VFS cache mode: off | minimal | writes | full
# - writes: Modified or copied files are buffered locally and uploaded in background (recommended)
# - full: Caches both reads and writes; enables random seeking for large media/archive files
cache_mode = writes

# Maximum size of local VFS disk cache (e.g. 5G, 10G, 50G, off)
cache_max_size = 10G

# Maximum age of cached files before automatic eviction (e.g. 24h, 7d)
cache_max_age = 24h

# Directory listing cache duration (instant directory navigation without repeated API calls)
dir_cache_time = 5m

[network]
# Socket connection timeout in seconds for probing SFTP/SSH remotes
# Unreachable or offline remotes are automatically skipped to prevent rclone hangs
sftp_probe_timeout = 0.2
"""

DEFAULTS = {
    "bind_address": "127.0.0.1",
    "port": 2123,
    "cache_mode": "writes",
    "cache_max_size": "10G",
    "cache_max_age": "24h",
    "dir_cache_time": "5m",
    "sftp_probe_timeout": 0.2,
}


def load_or_create_config(config_path: Path = CONFIG_FILE) -> dict:
    """Load config from path or generate default file if missing."""
    if not config_path.exists():
        try:
            config_path.parent.mkdir(parents=True, exist_ok=True)
            config_path.write_text(DEFAULT_CONFIG_CONTENT)
        except OSError:
            pass
        return DEFAULTS.copy()

    parser = configparser.ConfigParser()
    try:
        parser.read(config_path)
    except Exception:
        return DEFAULTS.copy()

    return {
        "bind_address": parser.get("server", "bind_address", fallback=DEFAULTS["bind_address"]),
        "port": parser.getint("server", "port", fallback=DEFAULTS["port"]),
        "cache_mode": parser.get("vfs", "cache_mode", fallback=DEFAULTS["cache_mode"]),
        "cache_max_size": parser.get("vfs", "cache_max_size", fallback=DEFAULTS["cache_max_size"]),
        "cache_max_age": parser.get("vfs", "cache_max_age", fallback=DEFAULTS["cache_max_age"]),
        "dir_cache_time": parser.get("vfs", "dir_cache_time", fallback=DEFAULTS["dir_cache_time"]),
        "sftp_probe_timeout": parser.getfloat("network", "sftp_probe_timeout", fallback=DEFAULTS["sftp_probe_timeout"]),
    }


def find_rclone_conf() -> str:
    candidates = [
        os.path.join(REAL_HOME, ".config", "rclone", "rclone.conf"),
        os.path.expanduser("~/.config/rclone/rclone.conf"),
    ]
    for p in candidates:
        if os.path.isfile(p):
            return p
    return candidates[0]


def is_port_open(host: str, port: int) -> bool:
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(0.3)
    try:
        res = sock.connect_ex((host, port))
        return res == 0
    finally:
        sock.close()


def is_pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def count_user_mc_instances() -> int:
    """Count active Midnight Commander instances belonging to current user."""
    try:
        output = subprocess.check_output(
            ["ps", "-u", str(os.getuid()), "-o", "comm="],
            stderr=subprocess.DEVNULL,
            text=True
        )
        count = 0
        for line in output.splitlines():
            base = os.path.basename(line.strip()).lower()
            if base in ("mc", "midnight-commander", "mc.real"):
                count += 1
        return count
    except Exception:
        return 1


def find_mc_pid() -> int | None:
    curr = os.getpid()
    while curr > 1:
        try:
            out = subprocess.check_output(
                ["ps", "-o", "ppid=", "-o", "comm=", "-p", str(curr)],
                text=True
            ).strip()
            parts = out.split(None, 1)
            if not parts:
                break
            ppid = int(parts[0])
            comm = parts[1] if len(parts) > 1 else ""
            base = os.path.basename(comm).lower()
            if base in ("mc", "midnight-commander", "mc.real"):
                return curr
            curr = ppid
        except Exception:
            break
    return None


def get_remotes(sftp_timeout: float = 0.2) -> list[str]:
    """Extract configured remotes. For SFTP remotes, probes port to avoid combine startup crashes."""
    conf_path = find_rclone_conf()
    if not os.path.isfile(conf_path):
        return []
    parser = configparser.ConfigParser()
    try:
        parser.read(conf_path)
    except Exception:
        return []

    active_remotes = []
    for sec in parser.sections():
        if sec.startswith("_"):
            continue
        rtype = parser[sec].get("type", "")
        if rtype == "sftp":
            host = parser[sec].get("host", "")
            port = int(parser[sec].get("port", 22))
            try:
                s = socket.socket()
                s.settimeout(sftp_timeout)
                if s.connect_ex((host, port)) == 0:
                    active_remotes.append(sec)
                s.close()
            except Exception:
                pass
        else:
            active_remotes.append(sec)

    return active_remotes


def build_rclone_cmd(cfg: dict, upstreams: str, rclone_bin: str = "rclone", conf_path: str = None) -> list[str]:
    cmd = [rclone_bin]
    if conf_path:
        cmd.extend(["--config", conf_path])
    cmd.extend([
        "serve", "ftp",
        "--addr", f"{cfg['bind_address']}:{cfg['port']}",
        "--vfs-cache-mode", cfg["cache_mode"],
        "--vfs-cache-max-size", cfg["cache_max_size"],
        "--vfs-cache-max-age", cfg["cache_max_age"],
        "--dir-cache-time", cfg["dir_cache_time"],
        "--combine-upstreams", upstreams,
        ":combine:",
    ])
    return cmd


def stop() -> int:
    if PID_FILE.is_file():
        try:
            pid = int(PID_FILE.read_text().strip())
            if is_pid_alive(pid):
                os.kill(pid, signal.SIGTERM)
                for _ in range(25):
                    time.sleep(0.1)
                    if not is_pid_alive(pid):
                        break
                if is_pid_alive(pid):
                    os.kill(pid, signal.SIGKILL)
        except Exception:
            pass
        try:
            PID_FILE.unlink(missing_ok=True)
        except Exception:
            pass
    print("mc-rclone stopped.")
    return 0


def status() -> int:
    cfg = load_or_create_config()
    addr = cfg["bind_address"]
    port = cfg["port"]
    if PID_FILE.is_file():
        try:
            pid = int(PID_FILE.read_text().strip())
            if is_pid_alive(pid) and is_port_open(addr, port):
                print(f"mc-rclone is running (PID {pid}, listening on {addr}:{port}).")
                return 0
        except Exception:
            pass
    print("mc-rclone is stopped.")
    return 1


def start(parent_pid: int | None = None) -> int:
    cfg = load_or_create_config()
    addr = cfg["bind_address"]
    port = cfg["port"]

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    if is_port_open(addr, port):
        print(f"mc-rclone is already running on {addr}:{port}.")
        return 0

    if parent_pid is None or parent_pid <= 1:
        parent_pid = find_mc_pid() or os.getppid()

    remotes = get_remotes(sftp_timeout=cfg["sftp_probe_timeout"])
    if not remotes:
        sys.stderr.write("Error: No active remotes found in rclone.conf\n")
        return 1

    upstreams = " ".join([f"{r}={r}:" for r in remotes])
    rclone_bin = shutil.which("rclone") or "/opt/homebrew/bin/rclone"
    conf_path = find_rclone_conf()

    cmd = build_rclone_cmd(cfg, upstreams, rclone_bin=rclone_bin, conf_path=conf_path)

    daemon_code = f"""
import subprocess, time, os, sys, signal

parent_pid = {parent_pid}
cmd = {cmd!r}
pid_file = {str(PID_FILE)!r}
log_file = {str(LOG_FILE)!r}

def count_mc():
    try:
        output = subprocess.check_output(
            ["ps", "-u", str(os.getuid()), "-o", "comm="],
            stderr=subprocess.DEVNULL,
            text=True
        )
        count = 0
        for line in output.splitlines():
            base = os.path.basename(line.strip()).lower()
            if base in ("mc", "midnight-commander", "mc.real"):
                count += 1
        return count
    except Exception:
        return 1

with open(log_file, "a") as log:
    proc = subprocess.Popen(cmd, stdout=log, stderr=log)
    with open(pid_file, "w") as f:
        f.write(str(proc.pid))

    try:
        while True:
            time.sleep(1.5)
            if proc.poll() is not None:
                break
            # Multi-instance check: terminate if no user MC instances remain
            if count_mc() == 0:
                break
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
        if os.path.isfile(pid_file):
            try:
                os.remove(pid_file)
            except Exception:
                pass
"""
    subprocess.Popen(
        [sys.executable, "-c", daemon_code],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    for _ in range(40):
        time.sleep(0.1)
        if is_port_open(addr, port):
            print(f"mc-rclone started successfully on {addr}:{port}.")
            return 0

    sys.stderr.write("Error: Timed out waiting for FTP server to listen.\n")
    return 1


def main():
    if len(sys.argv) < 2:
        print("Usage: mc-rclone {start [mc_pid]|stop|status}")
        sys.exit(1)

    cmd = sys.argv[1].lower()
    if cmd == "start":
        parent_pid = int(sys.argv[2]) if len(sys.argv) > 2 else None
        sys.exit(start(parent_pid))
    elif cmd == "stop":
        sys.exit(stop())
    elif cmd == "status":
        sys.exit(status())
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)


if __name__ == "__main__":
    main()
