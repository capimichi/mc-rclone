#!/usr/bin/env python3
"""
mc-rclone - Independent On-Demand Rclone FTP Bridge for GNU Midnight Commander.
Architecture:
- Each selected remote runs an isolated Rclone FTP instance on a dedicated loopback port.
- Active remotes are dynamically injected into MC's Directory Hotlist (~/.config/mc/hotlist).
- MC reloads the hotlist instantly upon pressing Ctrl + \\ (native stat mtime reload).
- Completely eliminates socket drops, combine overhead, and cross-remote interference.
- Central watchdog cleanly terminates all active servers and cleans the hotlist on MC exit.
"""

import sys
import os
import time
import json
import socket
import subprocess
import configparser
import shutil
import signal
import curses
from pathlib import Path


def get_real_home() -> str:
    if os.environ.get("MC_RCLONE_HOME"):
        return os.environ["MC_RCLONE_HOME"]
    home = os.environ.get("HOME", "")
    if "multiagy" in home or not os.path.isdir(os.path.join(home, ".config")):
        if os.path.isdir("/Users/michele"):
            return "/Users/michele"
    return os.path.expanduser("~")


def get_xdg_config_home() -> Path:
    val = os.environ.get("XDG_CONFIG_HOME")
    if val:
        return Path(val).expanduser()
    return Path(get_real_home()) / ".config"


def get_xdg_cache_home() -> Path:
    val = os.environ.get("XDG_CACHE_HOME")
    if val:
        return Path(val).expanduser()
    return Path(get_real_home()) / ".cache"


REAL_HOME = get_real_home()
CACHE_DIR = get_xdg_cache_home() / "mc" / "rclone"
ACTIVE_INSTANCES_FILE = CACHE_DIR / "active_instances.json"
WATCHDOG_PID_FILE = CACHE_DIR / "watchdog.pid"

CONFIG_DIR = get_xdg_config_home() / "mc-rclone"
CONFIG_FILE = CONFIG_DIR / "config.ini"
DEFAULT_REMOTES_FILE = CONFIG_DIR / "default_remotes.json"

DEFAULT_CONFIG_CONTENT = """# mc-rclone configuration file

[server]
# Base IP address to bind the FTP servers (loopback for security)
bind_address = 127.0.0.1

# Starting port for independent FTP instances (each active remote gets an incremental port)
base_port = 2123

[vfs]
# VFS cache mode: off | minimal | writes | full
# - writes: Modified or copied files are buffered locally and uploaded in background (recommended)
# - full: Caches both reads and writes; enables random seeking for large media/archive files
cache_mode = writes

# Maximum size of local VFS disk cache (e.g. 5G, 10G, 50G, off)
cache_max_size = 10G

# Maximum age of cached files before automatic eviction (e.g. 24h, 7d)
cache_max_age = 24h

# Directory listing cache duration (instant directory navigation without repeated API calls)
dir_cache_time = 5m

[network]
# Socket connection timeout in seconds for probing SFTP/SSH remotes
sftp_probe_timeout = 0.2
"""

DEFAULTS = {
    "bind_address": "127.0.0.1",
    "base_port": 2123,
    "port": 2123,
    "cache_mode": "writes",
    "cache_max_size": "10G",
    "cache_max_age": "24h",
    "dir_cache_time": "5m",
    "sftp_probe_timeout": 0.2,
}


def load_or_create_config(config_path: Path | None = None) -> dict:
    """Load config from path or generate default file if missing."""
    if config_path is None:
        config_path = CONFIG_FILE
    if not config_path.exists():
        try:
            config_path.parent.mkdir(parents=True, exist_ok=True)
            config_path.write_text(DEFAULT_CONFIG_CONTENT)
        except OSError:
            pass
        return DEFAULTS.copy()

    parser = configparser.ConfigParser()
    try:
        parser.read(config_path)
    except Exception:
        return DEFAULTS.copy()

    base_p = parser.getint("server", "base_port", fallback=parser.getint("server", "port", fallback=DEFAULTS["base_port"]))
    return {
        "bind_address": parser.get("server", "bind_address", fallback=DEFAULTS["bind_address"]),
        "base_port": base_p,
        "port": base_p,
        "cache_mode": parser.get("vfs", "cache_mode", fallback=DEFAULTS["cache_mode"]),
        "cache_max_size": parser.get("vfs", "cache_max_size", fallback=DEFAULTS["cache_max_size"]),
        "cache_max_age": parser.get("vfs", "cache_max_age", fallback=DEFAULTS["cache_max_age"]),
        "dir_cache_time": parser.get("vfs", "dir_cache_time", fallback=DEFAULTS["dir_cache_time"]),
        "sftp_probe_timeout": parser.getfloat("network", "sftp_probe_timeout", fallback=DEFAULTS["sftp_probe_timeout"]),
    }


def find_rclone_conf() -> str:
    candidates = [
        get_xdg_config_home() / "rclone" / "rclone.conf",
        Path(get_real_home()) / ".config" / "rclone" / "rclone.conf",
        Path.home() / ".config" / "rclone" / "rclone.conf",
    ]
    for p in candidates:
        if p.is_file():
            return str(p)
    return str(candidates[0])


def get_hotlist_path() -> Path:
    return get_xdg_config_home() / "mc" / "hotlist"


def is_port_open(host: str, port: int) -> bool:
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(0.2)
    try:
        res = sock.connect_ex((host, port))
        return res == 0
    finally:
        sock.close()


def is_pid_alive(pid: int | None) -> bool:
    if not pid or pid <= 1:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def count_user_mc_instances() -> int:
    """Count active Midnight Commander instances belonging to current user."""
    try:
        output = subprocess.check_output(
            ["/bin/ps", "-u", str(os.getuid()), "-o", "comm="],
            stderr=subprocess.DEVNULL,
            text=True
        )
        count = 0
        for line in output.splitlines():
            base = os.path.basename(line.strip()).lower()
            if base in ("mc", "midnight-commander", "mc.real"):
                count += 1
        return count
    except Exception:
        return 0


def find_mc_pid() -> int | None:
    curr = os.getpid()
    while curr > 1:
        try:
            out = subprocess.check_output(
                ["/bin/ps", "-o", "ppid=", "-o", "comm=", "-p", str(curr)],
                stderr=subprocess.DEVNULL,
                text=True
            ).strip()
            parts = out.split(None, 1)
            if not parts:
                break
            ppid = int(parts[0])
            comm = parts[1] if len(parts) > 1 else ""
            base = os.path.basename(comm).lower()
            if base in ("mc", "midnight-commander", "mc.real"):
                return curr
            curr = ppid
        except Exception:
            break
    return None


def get_active_instances() -> dict:
    """Read dictionary of currently active remote instances: {remote: {port, pid}}."""
    if ACTIVE_INSTANCES_FILE.is_file():
        try:
            data = json.loads(ACTIVE_INSTANCES_FILE.read_text())
            if isinstance(data, dict):
                # Filter out stale/dead processes
                live = {}
                for rem, info in data.items():
                    if is_pid_alive(info.get("pid")):
                        live[rem] = info
                return live
        except Exception:
            pass
    return {}


def save_active_instances(instances: dict):
    """Persist active instances to state file."""
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        ACTIVE_INSTANCES_FILE.write_text(json.dumps(instances, indent=2))
    except Exception:
        pass


def get_default_remotes() -> list[str]:
    """Get last saved remote preferences."""
    if DEFAULT_REMOTES_FILE.is_file():
        try:
            data = json.loads(DEFAULT_REMOTES_FILE.read_text())
            if isinstance(data, list):
                return data
        except Exception:
            pass
    return []


def save_default_remotes(remotes: list[str]):
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        DEFAULT_REMOTES_FILE.write_text(json.dumps(sorted(list(set(remotes))), indent=2))
    except Exception:
        pass


def resolve_remote_type_and_config(parser: configparser.ConfigParser, sec: str) -> tuple[str, configparser.SectionProxy]:
    """Resolve aliases recursively to find the underlying remote type and config."""
    visited = set()
    curr = sec
    while curr in parser.sections() and parser[curr].get("type") == "alias" and curr not in visited:
        visited.add(curr)
        target = parser[curr].get("remote", "").strip()
        curr = target.split(":")[0]
    target_sec = curr if curr in parser.sections() else sec
    section_proxy = parser[target_sec]
    return section_proxy.get("type", "unknown"), section_proxy


def get_all_remotes_info() -> list[tuple[str, str]]:
    """Return sorted list of (remote_name, description) for all configured remotes."""
    conf_path = find_rclone_conf()
    if not os.path.isfile(conf_path):
        return []
    parser = configparser.ConfigParser()
    try:
        parser.read(conf_path)
    except Exception:
        return []

    results = []
    for sec in parser.sections():
        if sec.startswith("_"):
            continue
        raw_type = parser[sec].get("type", "unknown")
        real_type, real_conf = resolve_remote_type_and_config(parser, sec)
        if raw_type == "alias":
            target = parser[sec].get("remote", "")
            desc = f"alias -> {target}"
        elif real_type == "sftp":
            host = real_conf.get("host", "")
            port = real_conf.get("port", "22")
            desc = f"sftp: {host}:{port}"
        elif real_type == "ftp":
            host = real_conf.get("host", "")
            desc = f"ftp: {host}"
        else:
            desc = real_type
        results.append((sec, desc))

    return sorted(results, key=lambda x: x[0].lower())


def probe_remote(sec: str, sftp_timeout: float = 0.2) -> bool:
    """Probe network remotes (SFTP/FTP) to ensure reachability before mounting."""
    conf_path = find_rclone_conf()
    if not os.path.isfile(conf_path):
        return True
    parser = configparser.ConfigParser()
    try:
        parser.read(conf_path)
    except Exception:
        return True

    if sec not in parser.sections():
        return False

    real_type, real_conf = resolve_remote_type_and_config(parser, sec)
    if real_type == "sftp":
        host = real_conf.get("host", "")
        port = int(real_conf.get("port", 22))
        try:
            s = socket.socket()
            s.settimeout(sftp_timeout)
            ok = (s.connect_ex((host, port)) == 0)
            s.close()
            return ok
        except Exception:
            return False
    elif real_type == "ftp":
        host = real_conf.get("host", "")
        port = int(real_conf.get("port", 21))
        try:
            s = socket.socket()
            s.settimeout(sftp_timeout)
            ok = (s.connect_ex((host, port)) == 0)
            s.close()
            return ok
        except Exception:
            return False

    # Cloud providers (drive, dropbox, onedrive, s3, etc.) are always treated as reachable
    return True


def allocate_port(instances: dict, base_port: int, bind_addr: str) -> int:
    """Find the next available port for a new remote instance."""
    used_ports = {info["port"] for info in instances.values() if "port" in info}
    candidate = base_port
    while True:
        if candidate not in used_ports and not is_port_open(bind_addr, candidate):
            return candidate
        candidate += 1


def sync_hotlist(instances: dict):
    """Dynamically update ~/.config/mc/hotlist with currently active remotes and touch mtime."""
    hotlist_path = get_hotlist_path()
    if not hotlist_path.parent.is_dir():
        hotlist_path.parent.mkdir(parents=True, exist_ok=True)

    lines = []
    if hotlist_path.is_file():
        try:
            lines = hotlist_path.read_text().splitlines(keepends=True)
        except Exception:
            lines = []

    # Filter out existing Cloud: entries and 127.0.0.1:212* lines
    filtered = [
        l for l in lines
        if not (l.strip().startswith('ENTRY "Cloud:') or '127.0.0.1:212' in l)
    ]

    # Append current live instances
    for rem in sorted(instances.keys()):
        port = instances[rem]["port"]
        filtered.append(f'ENTRY "Cloud: {rem}" URL "ftp://127.0.0.1:{port}"\n')

    try:
        hotlist_path.write_text("".join(filtered))
        # Touch file to force MC's stat() to detect mtime update immediately
        os.utime(hotlist_path, None)
    except Exception as e:
        sys.stderr.write(f"Warning: Could not update hotlist: {e}\n")


def ensure_watchdog(parent_mc_pid: int | None = None):
    """Ensure the background watchdog supervisor is running."""
    if WATCHDOG_PID_FILE.is_file():
        try:
            wpid = int(WATCHDOG_PID_FILE.read_text().strip())
            if is_pid_alive(wpid):
                return
        except Exception:
            pass

    watchdog_script = f"""
import subprocess, time, os, sys, signal, json

parent_mc_pid = {parent_mc_pid}
state_file = {str(ACTIVE_INSTANCES_FILE)!r}
watchdog_pid_file = {str(WATCHDOG_PID_FILE)!r}
hotlist_file = {str(get_hotlist_path())!r}

with open(watchdog_pid_file, 'w') as f:
    f.write(str(os.getpid()))

def count_mc():
    try:
        out = subprocess.check_output(['/bin/ps', '-u', str(os.getuid()), '-o', 'comm='], text=True)
        return sum(1 for line in out.splitlines() if os.path.basename(line.strip()).lower() in ('mc', 'midnight-commander', 'mc.real'))
    except Exception:
        return 0

def kill_all():
    if os.path.isfile(state_file):
        try:
            with open(state_file) as sf:
                data = json.load(sf)
            for info in data.values():
                pid = info.get('pid')
                if pid:
                    try:
                        os.kill(pid, signal.SIGTERM)
                    except OSError:
                        pass
        except Exception:
            pass
        try:
            os.remove(state_file)
        except Exception:
            pass

    # Clean hotlist entries
    if os.path.isfile(hotlist_file):
        try:
            with open(hotlist_file, 'r') as hf:
                lines = hf.readlines()
            filtered = [l for l in lines if not (l.strip().startswith('ENTRY "Cloud:') or '127.0.0.1:212' in l)]
            with open(hotlist_file, 'w') as hf:
                hf.writelines(filtered)
            os.utime(hotlist_file, None)
        except Exception:
            pass

try:
    while True:
        time.sleep(0.5)
        if not os.path.isfile(state_file):
            break

        # If launched from MC, monitor its parent PID
        if parent_mc_pid and parent_mc_pid > 1:
            try:
                os.kill(parent_mc_pid, 0)
            except (OSError, ProcessLookupError):
                if count_mc() == 0:
                    break
        else:
            # Standalone mode: exit if no MC running for 2 seconds
            if count_mc() == 0:
                break
finally:
    kill_all()
    if os.path.isfile(watchdog_pid_file):
        try:
            os.remove(watchdog_pid_file)
        except Exception:
            pass
"""
    subprocess.Popen(
        [sys.executable, "-c", watchdog_script],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def build_single_rclone_cmd(
    remote: str,
    port: int,
    cfg: dict,
    rclone_bin: str = "rclone",
    conf_path: str | None = None
) -> list[str]:
    """Construct argument list for isolated rclone serve ftp process."""
    cmd = [rclone_bin]
    if conf_path:
        cmd.extend(["--config", conf_path])
    cmd.extend([
        "serve", "ftp",
        f"{remote}:",
        "--addr", f"{cfg['bind_address']}:{port}",
        "--vfs-cache-mode", cfg["cache_mode"],
        "--vfs-cache-max-size", cfg["cache_max_size"],
        "--vfs-cache-max-age", cfg["cache_max_age"],
        "--dir-cache-time", cfg["dir_cache_time"],
    ])
    return cmd


def start_single_instance(remote: str, port: int, cfg: dict) -> int | None:
    """Spawn an isolated Rclone FTP server for a single remote."""
    rclone_bin = shutil.which("rclone") or "/opt/homebrew/bin/rclone"
    conf_path = find_rclone_conf()
    log_file = CACHE_DIR / f"rclone_{remote}.log"

    cmd = build_single_rclone_cmd(remote, port, cfg, rclone_bin=rclone_bin, conf_path=conf_path)

    with open(log_file, "a") as log:
        proc = subprocess.Popen(
            cmd,
            stdout=log,
            stderr=log,
            start_new_session=True
        )

    for _ in range(50):
        time.sleep(0.05)
        if is_port_open(cfg["bind_address"], port):
            return proc.pid

    # Failed to bind
    try:
        proc.kill()
    except Exception:
        pass
    return None


def apply_remotes(target_remotes: list[str], parent_pid: int | None = None) -> int:
    """Synchronize running servers with target remotes list."""
    cfg = load_or_create_config()
    addr = cfg["bind_address"]
    base_port = cfg["base_port"]

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    current_instances = get_active_instances()
    target_set = set(target_remotes)

    if parent_pid is None or parent_pid <= 1:
        parent_pid = find_mc_pid()

    # 1. Stop any running instances that were deselected
    to_remove = [rem for rem in current_instances if rem not in target_set]
    for rem in to_remove:
        pid = current_instances[rem].get("pid")
        if pid:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        del current_instances[rem]

    # 2. Start newly selected remotes
    to_add = [rem for rem in target_remotes if rem not in current_instances]
    for rem in to_add:
        # Probe remote
        if not probe_remote(rem, sftp_timeout=cfg["sftp_probe_timeout"]):
            sys.stderr.write(f"Warning: Remote '{rem}' is currently unreachable (skipped).\n")
            continue

        port = allocate_port(current_instances, base_port, addr)
        pid = start_single_instance(rem, port, cfg)
        if pid:
            current_instances[rem] = {
                "port": port,
                "pid": pid,
                "remote": rem,
            }
        else:
            sys.stderr.write(f"Error: Failed to start server for '{rem}' on port {port}.\n")

    save_active_instances(current_instances)
    if target_remotes:
        save_default_remotes(target_remotes)

    # 3. Update hotlist and watchdog
    sync_hotlist(current_instances)

    if current_instances:
        ensure_watchdog(parent_pid)
        print("✓ Active cloud remotes:")
        for rem, info in sorted(current_instances.items()):
            print(f"  • {rem} -> ftp://{addr}:{info['port']}")
        print("Press Ctrl + \\ (Hotlist) in MC to open.")
    else:
        print("All cloud remotes unmounted.")

    return 0


def stop_all() -> int:
    """Stop all running remote instances and clean state."""
    instances = get_active_instances()
    for rem, info in instances.items():
        pid = info.get("pid")
        if pid:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass

    if ACTIVE_INSTANCES_FILE.is_file():
        ACTIVE_INSTANCES_FILE.unlink(missing_ok=True)

    if WATCHDOG_PID_FILE.is_file():
        try:
            wpid = int(WATCHDOG_PID_FILE.read_text().strip())
            os.kill(wpid, signal.SIGTERM)
        except Exception:
            pass
        WATCHDOG_PID_FILE.unlink(missing_ok=True)

    sync_hotlist({})
    print("mc-rclone stopped. All cloud remotes unmounted.")
    return 0


def status() -> int:
    """Show status of all running instances."""
    instances = get_active_instances()
    cfg = load_or_create_config()
    addr = cfg["bind_address"]

    if instances:
        print(f"mc-rclone is running ({len(instances)} active remotes):")
        for rem, info in sorted(instances.items()):
            print(f"  • {rem:25} listening on ftp://{addr}:{info['port']} (PID {info['pid']})")
        return 0
    else:
        print("mc-rclone is stopped (no active cloud remotes).")
        return 1


def curses_checklist_ui(stdscr, remotes_info: list[tuple[str, str]], active_set: set[str]) -> list[str] | None:
    """Full-screen curses checklist picker with live filtering."""
    curses.curs_set(0)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)   # Cursor
        curses.init_pair(2, curses.COLOR_GREEN, -1)                  # Active checkbox
        curses.init_pair(3, curses.COLOR_YELLOW, -1)                 # Type tag

    selected = set(active_set)
    idx = 0
    query = ""

    while True:
        stdscr.clear()
        h, w = stdscr.getmaxyx()

        # Title and Instructions
        title = " mc-rclone: Select Cloud Remotes to Mount "
        stdscr.addstr(0, max(0, (w - len(title)) // 2), title, curses.A_BOLD)
        help_bar = "UP/DOWN: Navigate | SPACE: Toggle | ENTER: Confirm | q/ESC: Cancel"
        stdscr.addstr(1, max(0, (w - len(help_bar)) // 2), help_bar, curses.A_DIM)

        # Filter Prompt
        prompt = f"Filter ({len(remotes_info)} remotes): {query}_"
        stdscr.addstr(3, 2, prompt, curses.A_BOLD)

        # Filter remotes based on query
        filtered = [
            (name, desc) for name, desc in remotes_info
            if query.lower() in name.lower() or query.lower() in desc.lower()
        ]
        if idx >= len(filtered):
            idx = max(0, len(filtered) - 1)

        # Render rows
        max_rows = h - 6
        start_row = max(0, idx - max_rows // 2)
        end_row = min(len(filtered), start_row + max_rows)

        for i in range(start_row, end_row):
            name, desc = filtered[i]
            is_active = name in selected
            box = "[X]" if is_active else "[ ]"
            row_y = 5 + (i - start_row)

            line_prefix = f" {box} {name} "
            desc_str = f"({desc})"
            avail_w = w - 4

            full_line = f"{line_prefix}{desc_str}"[:avail_w].ljust(avail_w)

            attr = curses.A_NORMAL
            if i == idx:
                attr = curses.color_pair(1) | curses.A_BOLD
            elif is_active:
                attr = curses.color_pair(2) | curses.A_BOLD

            stdscr.addstr(row_y, 2, full_line, attr)

        stdscr.refresh()

        key = stdscr.getch()
        if key in (27, ord('q')):  # ESC or q
            return None
        elif key in (curses.KEY_UP, ord('k')):
            if idx > 0:
                idx -= 1
        elif key in (curses.KEY_DOWN, ord('j')):
            if idx < len(filtered) - 1:
                idx += 1
        elif key == ord(' '):  # SPACE toggles checkbox
            if filtered:
                curr_name = filtered[idx][0]
                if curr_name in selected:
                    selected.remove(curr_name)
                else:
                    selected.add(curr_name)
        elif key in (10, 13, curses.KEY_ENTER):  # ENTER confirms
            return list(selected)
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            query = query[:-1]
            idx = 0
        elif 32 <= key <= 126:
            query += chr(key)
            idx = 0


def select_command(args: list[str] | None = None) -> int:
    """Run interactive remote selector or apply arguments."""
    parent_pid = find_mc_pid() or os.getppid()
    all_remotes_info = get_all_remotes_info()
    if not all_remotes_info:
        sys.stderr.write("Error: No remotes found in rclone.conf\n")
        return 1

    all_names = {name for name, _ in all_remotes_info}
    active_instances = get_active_instances()
    active_now = list(active_instances.keys())
    if not active_now:
        active_now = get_default_remotes()

    # If arguments supplied via CLI, use them directly
    if args:
        invalid = [a for a in args if a not in all_names]
        if invalid:
            sys.stderr.write(f"Error: Unknown remotes: {', '.join(invalid)}\n")
            return 1
        return apply_remotes(args, parent_pid=parent_pid)

    # Interactive UI
    if not sys.stdin.isatty():
        sys.stderr.write("Non-interactive terminal: specify remotes as arguments.\n")
        print("Available remotes:")
        for name, desc in all_remotes_info:
            print(f"  {name} ({desc})")
        return 1

    try:
        chosen = curses.wrapper(curses_checklist_ui, all_remotes_info, set(active_now))
        if chosen is None:
            print("Selection cancelled.")
            return 0
        return apply_remotes(chosen, parent_pid=parent_pid)
    except Exception as e:
        sys.stderr.write(f"UI error: {e}\n")
        return 1


def add_command(remotes: list[str]) -> int:
    """Add remotes to active set."""
    if not remotes:
        sys.stderr.write("Usage: mc-rclone add <remote1> [remote2 ...]\n")
        return 1
    current = set(get_active_instances().keys())
    current.update(remotes)
    return apply_remotes(list(current))


def remove_command(remotes: list[str]) -> int:
    """Remove remotes from active set."""
    if not remotes:
        sys.stderr.write("Usage: mc-rclone remove <remote1> [remote2 ...]\n")
        return 1
    current = set(get_active_instances().keys())
    current.difference_update(remotes)
    return apply_remotes(list(current))


def main():
    if len(sys.argv) < 2:
        # Default behavior when invoked without arguments: open selector
        sys.exit(select_command())

    cmd = sys.argv[1].lower()
    if cmd == "select":
        sys.exit(select_command(sys.argv[2:] if len(sys.argv) > 2 else None))
    elif cmd == "start":
        # Start with default/active remotes, or open selector if none
        active = list(get_active_instances().keys()) or get_default_remotes()
        parent_pid = int(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2].isdigit() else None
        if active:
            sys.exit(apply_remotes(active, parent_pid=parent_pid))
        else:
            sys.exit(select_command())
    elif cmd == "add":
        sys.exit(add_command(sys.argv[2:]))
    elif cmd == "remove":
        sys.exit(remove_command(sys.argv[2:]))
    elif cmd == "stop":
        sys.exit(stop_all())
    elif cmd == "status":
        sys.exit(status())
    else:
        print(f"Unknown command: {cmd}")
        print("Usage: mc-rclone {select|start|add|remove|stop|status}")
        sys.exit(1)


if __name__ == "__main__":
    main()
