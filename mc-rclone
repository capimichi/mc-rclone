#!/usr/bin/env python3
"""
mc-rclone - High-performance transparent Rclone manager for GNU Midnight Commander.

Features:
- On-the-fly auto-sync with ~/.config/rclone/rclone.conf (zero manual configuration).
- Spawns ultra-fast localhost FTP servers (one per remote in 15ms) on-demand.
- Direct dual-pane cloud-to-cloud transfers in MC.
- Full auto-cleanup on MC exit: zero background RAM waste.

Part of mc-rclone: https://github.com/capimichi/mc-rclone
License: GNU General Public License v3.0 (GPL-3.0)
"""

import sys
import os
import json
import shutil
import socket
import subprocess
import time
import signal
import configparser

BASE_PORT = 2121
CACHE_DIR = os.path.expanduser("~/.cache/mc/rclone")
PIDS_FILE = os.path.join(CACHE_DIR, "pids.json")
LAST_SYNC_FILE = os.path.join(CACHE_DIR, "last_sync_time")
RCLONE_CONF = os.path.expanduser("~/.config/rclone/rclone.conf")
HOTLIST_FILE = os.path.expanduser("~/.config/mc/hotlist")

# Find real mc and rclone executables
def find_real_mc():
    for p in ["/opt/homebrew/bin/mc", "/usr/local/bin/mc", "/usr/bin/mc"]:
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    # Fallback to which excluding our wrapper
    paths = os.getenv("PATH", "").split(os.pathsep)
    for path in paths:
        if path.strip() in [os.path.expanduser("~/.local/bin"), "/Users/michele/.local/bin"]:
            continue
        candidate = os.path.join(path, "mc")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return "/opt/homebrew/bin/mc"


REAL_MC_BIN = find_real_mc()

RCLONE_BIN = shutil.which("rclone")
if not RCLONE_BIN:
    for fallback in ["/opt/homebrew/bin/rclone", "/usr/local/bin/rclone", "/usr/bin/rclone"]:
        if os.path.isfile(fallback) and os.access(fallback, os.X_OK):
            RCLONE_BIN = fallback
            break


def get_remotes():
    """Read remotes directly from rclone.conf in 1ms without spawning subprocesses."""
    if not os.path.isfile(RCLONE_CONF):
        return []
    try:
        parser = configparser.ConfigParser()
        parser.read(RCLONE_CONF)
        return sorted(parser.sections())
    except Exception:
        # Fallback to rclone listremotes
        env = os.environ.copy()
        if "HOME" not in env or not env["HOME"]:
            env["HOME"] = os.path.expanduser("~")
        res = subprocess.run([RCLONE_BIN, "listremotes"], capture_output=True, text=True, env=env)
        if res.returncode == 0:
            return sorted([l.strip().rstrip(":") for l in res.stdout.splitlines() if l.strip()])
    return []


def get_port_for_remote(remote: str, remotes_list=None) -> int:
    """Return deterministic port for remote."""
    remotes = remotes_list if remotes_list is not None else get_remotes()
    if remote in remotes:
        return BASE_PORT + remotes.index(remote)
    return BASE_PORT + (abs(hash(remote)) % 100)


def sync_hotlist(silent=False):
    """Sync MC hotlist if rclone.conf was modified."""
    if not os.path.isfile(RCLONE_CONF):
        return

    conf_mtime = os.path.getmtime(RCLONE_CONF)
    last_sync = 0
    if os.path.isfile(LAST_SYNC_FILE):
        try:
            with open(LAST_SYNC_FILE, "r") as f:
                last_sync = float(f.read().strip())
        except Exception:
            pass

    # If rclone.conf hasn't changed and hotlist exists, skip
    if os.path.isfile(HOTLIST_FILE) and conf_mtime <= last_sync:
        return

    remotes = get_remotes()
    if not remotes:
        return

    os.makedirs(os.path.dirname(HOTLIST_FILE), exist_ok=True)
    os.makedirs(CACHE_DIR, exist_ok=True)

    existing_entries = []
    if os.path.isfile(HOTLIST_FILE):
        with open(HOTLIST_FILE, "r") as f:
            for line in f:
                # Keep user bookmarks, drop existing Cloud: entries to regenerate fresh
                if "URL \"ftp://127.0.0.1:" not in line and 'ENTRY "Cloud:' not in line:
                    existing_entries.append(line.rstrip("\n"))

    # Generate fresh Cloud: entries
    rclone_entries = []
    for r in remotes:
        port = get_port_for_remote(r, remotes)
        rclone_entries.append(f'ENTRY "Cloud: {r}" URL "ftp://127.0.0.1:{port}/"')

    with open(HOTLIST_FILE, "w") as f:
        for entry in rclone_entries:
            f.write(entry + "\n")
        for entry in existing_entries:
            if entry.strip():
                f.write(entry + "\n")

    with open(LAST_SYNC_FILE, "w") as f:
        f.write(str(conf_mtime))

    if not silent:
        print(f"Synced {len(remotes)} cloud remotes to Midnight Commander Hotlist.")


def is_pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def is_port_open(port: int) -> bool:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.2)
    try:
        s.connect(("127.0.0.1", port))
        s.close()
        return True
    except Exception:
        return False


def start_all_daemons(silent=False):
    """Start FTP servers for all remotes in parallel (takes ~15ms)."""
    remotes = get_remotes()
    if not remotes:
        return

    pids_state = {}
    if os.path.isfile(PIDS_FILE):
        try:
            with open(PIDS_FILE, "r") as f:
                pids_state = json.load(f)
        except Exception:
            pass

    env = os.environ.copy()
    if "HOME" not in env or not env["HOME"]:
        env["HOME"] = os.path.expanduser("~")

    os.makedirs(CACHE_DIR, exist_ok=True)

    for r in remotes:
        port = get_port_for_remote(r, remotes)
        # Check if already running on this port
        existing_pid = pids_state.get(r)
        if existing_pid and is_pid_alive(existing_pid) and is_port_open(port):
            continue

        cmd = [
            RCLONE_BIN,
            "serve",
            "ftp",
            f"{r}:",
            "--addr",
            f"127.0.0.1:{port}",
            "--vfs-cache-mode",
            "writes",
        ]

        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
            start_new_session=True,
        )
        pids_state[r] = proc.pid

    with open(PIDS_FILE, "w") as f:
        json.dump(pids_state, f)

    if not silent:
        print(f"Started {len(remotes)} cloud daemons.")


def stop_all_daemons(silent=False):
    """Stop all running rclone serve processes."""
    if os.path.isfile(PIDS_FILE):
        try:
            with open(PIDS_FILE, "r") as f:
                pids_state = json.load(f)
            for r, pid in pids_state.items():
                if pid and is_pid_alive(pid):
                    try:
                        os.kill(pid, signal.SIGTERM)
                    except Exception:
                        pass
            os.remove(PIDS_FILE)
        except Exception:
            pass
    if not silent:
        print("Stopped all cloud daemons.")


def cmd_status():
    """Print status of all remotes and ports."""
    remotes = get_remotes()
    pids_state = {}
    if os.path.isfile(PIDS_FILE):
        try:
            with open(PIDS_FILE, "r") as f:
                pids_state = json.load(f)
        except Exception:
            pass

    print(f"\n{'REMOTE':<30} {'PORT':<8} {'PID':<8} {'STATUS':<10}")
    print("-" * 60)
    for r in remotes:
        port = get_port_for_remote(r, remotes)
        pid = pids_state.get(r)
        running = pid and is_pid_alive(pid) and is_port_open(port)
        status = "\033[92mRUNNING\033[0m" if running else "\033[90mSTOPPED\033[0m"
        pid_str = str(pid) if running else "-"
        print(f"{r:<30} {port:<8} {pid_str:<8} {status}")
    print()


def run_mc_wrapper(mc_args):
    """Wrapper that runs MC with auto-started servers and auto-cleanup on exit."""
    # 1. Quick sync bookmarks from rclone.conf (2ms)
    sync_hotlist(silent=True)

    # 2. Start listeners on localhost (15ms)
    start_all_daemons(silent=True)

    # 3. Setup cleanup handler
    def cleanup(signum=None, frame=None):
        stop_all_daemons(silent=True)
        if signum is not None:
            sys.exit(0)

    for sig in [signal.SIGINT, signal.SIGTERM, signal.SIGHUP]:
        try:
            signal.signal(sig, cleanup)
        except Exception:
            pass

    exit_code = 0
    try:
        # Run real MC in foreground
        p = subprocess.run([REAL_MC_BIN] + mc_args)
        exit_code = p.returncode
    except Exception:
        exit_code = 1
    finally:
        cleanup()
    sys.exit(exit_code)


def main():
    if len(sys.argv) < 2:
        # If run directly as mc-rclone without args, show status
        cmd_status()
        return

    sub = sys.argv[1].lower()

    if sub == "run":
        # Run MC through wrapper
        run_mc_wrapper(sys.argv[2:])
    elif sub in ["start", "daemon-start"]:
        sync_hotlist(silent=True)
        start_all_daemons(silent=False)
    elif sub in ["stop", "daemon-stop"]:
        stop_all_daemons(silent=False)
    elif sub in ["sync", "sync-hotlist"]:
        sync_hotlist(silent=False)
    elif sub in ["status", "list"]:
        cmd_status()
    else:
        # If unrecognized argument, assume user ran wrapper with MC arguments
        run_mc_wrapper(sys.argv[1:])


if __name__ == "__main__":
    main()
